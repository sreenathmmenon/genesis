# ─── Genesis — Local Development Environment ────────────────────────────────
# Copy this file: cp .env.example .env
# Then fill in your API keys. Everything with a default works out of the box
# after `docker compose up -d`.

# ─── Database (Docker default — works with docker-compose.yml) ───────────────
DATABASE_URL=postgresql+asyncpg://genesis:genesis_dev@localhost:5432/genesis
POSTGRES_DB=genesis
POSTGRES_USER=genesis
POSTGRES_PASSWORD=genesis_dev

# ─── Redis (Docker default) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Qdrant (Docker default — or use Qdrant Cloud free tier) ─────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=genesis_patterns

# ─── LLMs (at minimum, set ANTHROPIC_API_KEY) ────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=                      # optional
GOOGLE_API_KEY=                      # optional

# ─── Telegram (required for bot + agent output delivery) ─────────────────────
# 1. Create a bot: https://t.me/BotFather → /newbot → copy the token
# 2. Get your chat ID: message @userinfobot → copy the numeric ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=                # leave empty for local (uses polling mode)

# ─── Slack (optional — for slack_send tool) ───────────────────────────────────
SLACK_WEBHOOK_URL=

# ─── Email — SendGrid preferred, falls back to SMTP ─────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=

# SMTP fallback (if SendGrid not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── GitHub (optional — for github_api tool and PR Guardian template) ─────────
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# ─── Jira (optional — for jira_api tool) ─────────────────────────────────────
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ─── Notion (optional — for notion_read tool) ────────────────────────────────
NOTION_API_KEY=

# ─── Twilio — WhatsApp + SMS (optional) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# ─── Google Workspace (optional) ─────────────────────────────────────────────
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_SHEETS_CREDENTIALS_JSON=

# ─── Modal (optional — for sandboxed code_executor tool) ─────────────────────
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ─── App ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_32_char_string
ENVIRONMENT=development
LOG_LEVEL=INFO
